    <h1>🦀 Хитозан: Путь от панциря до продукта</h1>
    <p class="sub">Материалы для офлайн-игры · Распечатайте и разрежьте по границам</p>

    <h2>📜 Правила офлайн-игры</h2>
    <div class="info"><b>Цель:</b> заработать максимум денег, доставив сырьё из городов в Москву.</div>
    <ol>
      <li>Разделите класс на <b>3 команды-завода</b>: Промышленность 🏭, Медицина 💊, Фермерство 🌾.</li>
      <li>Раздайте каждой команде карточку завода и бланк подсчёта.</li>
      <li>Выложите на стол карточки сырья и карту городов.</li>
      <li>Каждая команда по очереди выбирает: <b>город → сырьё → транспорт</b>.</li>
      <li>Учитель объявляет результат, команда записывает в бланк.</li>
      <li>После <b>8 раундов</b> подсчитывается итог. Побеждает команда с максимальным балансом.</li>
    </ol>
    <div class="info"><b>Формула:</b> Доход = Цена_сырья × 2 × Качество × Бонус_завода. Прибыль = Доход − Расход транспорта.</div>

    <div class="page-break"></div>
    <h2>🎴 Карточки сырья</h2>
    <div class="grid-2">
      <div class="card"><div class="icon">🦀</div><h3>Панцирь краба</h3><p>Высокое качество, подходит для медицины</p></div>
      <div class="card"><div class="icon">🦐</div><h3>Панцирь креветки</h3><p>Высокое качество, подходит для медицины</p></div>
      <div class="card"><div class="icon">🦞</div><h3>Панцирь рака</h3><p>Подходит для фермерства</p></div>
      <div class="card"><div class="icon">🐛</div><h3>Кутикулы насекомых</h3><p>Подходит для фермерства</p></div>
    </div>

    <div class="page-break"></div>
    <h2>🏭 Карточки заводов</h2>
    <div class="grid-3">
      <div class="card"><div class="icon">🏭</div><h3>Промышленность</h3><p>Универсал</p><div class="allowed">🦀 🦐 🦞 🐛</div><div class="bonus">без бонусов</div></div>
      <div class="card"><div class="icon">💊</div><h3>Медицина</h3><p>Только морепродукты</p><div class="allowed">🦀 🦐</div><div class="bonus">+30% к крабу и креветке</div></div>
      <div class="card"><div class="icon">🌾</div><h3>Фермерство</h3><p>Без морепродуктов</p><div class="allowed">🦞 🐛</div><div class="bonus">+20% к раку и насекомым</div></div>
    </div>

    <div class="page-break"></div>
    <h2>🗺️ Карта городов</h2>
    <div class="grid-2">
      <div class="card green"><div class="icon">🌊</div><h3>Мурманск</h3><div class="row"><span class="label">Сильное:</span> 🦀 Краб — 30💰 (кач. 1.0)</div><div class="row"><span class="label">Слабое:</span> 🐛 Насекомые — 120💰 (кач. 0.4)</div><div class="row"><span class="label">Транспорт:</span> море, ж/д, авиа</div></div>
      <div class="card green"><div class="icon">🌊</div><h3>Владивосток</h3><div class="row"><span class="label">Сильное:</span> 🦐 Креветка — 25💰 (кач. 1.0)</div><div class="row"><span class="label">Слабое:</span> 🦀 Краб — 70💰 (кач. 0.7)</div><div class="row"><span class="label">Транспорт:</span> море, ж/д, авиа</div></div>
      <div class="card green"><div class="icon">🏞️</div><h3>Астрахань</h3><div class="row"><span class="label">Сильное:</span> 🦞 Рак — 30💰 (кач. 1.0)</div><div class="row"><span class="label">Слабое:</span> 🦀 Краб — 90💰 (кач. 0.5)</div><div class="row"><span class="label">Транспорт:</span> ж/д, авиа (нет моря!)</div></div>
      <div class="card green"><div class="icon">❄️</div><h3>Архангельск</h3><div class="row"><span class="label">Сильное:</span> 🐛 Насекомые — 25💰 (кач. 1.0)</div><div class="row"><span class="label">Слабое:</span> 🦐 Креветка — 80💰 (кач. 0.6)</div><div class="row"><span class="label">Транспорт:</span> море, ж/д, авиа</div></div>
    </div>

    ${[1,2,3].map(n => `
      <div class="page-break"></div>
      <div class="score-title">🧮 Бланк подсчёта — команда №${n}</div>
      <div class="score-header">
        <div><b>Завод:</b> ____________________</div>
        <div><b>Команда:</b> ____________________</div>
        <div><b>Дата:</b> ____________</div>
      </div>
      <table>
        <thead><tr><th>Раунд</th><th>Город</th><th>Сырьё</th><th>Транспорт</th><th>Доход</th><th>Расход</th><th>Прибыль</th><th>Баланс</th></tr></thead>
        <tbody>
          <tr><td>Старт</td><td>—</td><td>—</td><td>—</td><td>—</td><td>—</td><td>—</td><td><b>1000</b></td></tr>
          ${[1,2,3,4,5,6,7,8].map(i => `<tr><td>${i}</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>`).join('')}
          <tr class="total"><td colspan="7" style="text-align:right;">ИТОГО:</td><td></td></tr>
        </tbody>
      </table>
      <div class="footer">
        <p><b>Формула:</b> Доход = Цена_сырья × 2 × Качество × Бонус_завода</p>
        <p><b>Прибыль</b> = Доход − Расход транспорта</p>
      </div>
    `).join('')}

    </body></html>
  `;

  const w = window.open('', '_blank');
