<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Хитозан: Материалы для учителя</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --primary: #1e6fd9;
    --primary-light: #e8f1fd;
    --accent: #ffb400;
    --success: #22c55e;
    --danger: #ef4444;
    --gray: #64748b;
    --light: #f8fafc;
    --border: #e2e8f0;
    --shadow: 0 4px 16px rgba(0,0,0,0.08);
  }

  body {
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    background: var(--light);
    color: #1e293b;
    line-height: 1.6;
  }

  .container { max-width: 1000px; margin: 0 auto; padding: 20px; }

  /* ШАПКА */
  .header {
    background: linear-gradient(135deg, #1e6fd9, #0ea5e9);
    color: #fff;
    padding: 32px 40px;
    border-radius: 20px;
    margin-bottom: 24px;
    box-shadow: var(--shadow);
    text-align: center;
  }
  .header h1 { font-size: 1.8rem; margin-bottom: 10px; }
  .header p { font-size: 1rem; opacity: 0.95; }
  .header .badge {
    display: inline-block;
    background: rgba(255,255,255,0.2);
    padding: 4px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-top: 14px;
  }

  /* СЕКЦИИ */
  .section {
    background: #fff;
    border-radius: 16px;
    padding: 32px;
    box-shadow: var(--shadow);
    margin-bottom: 20px;
  }
  .section h2 {
    font-size: 1.3rem;
    color: var(--primary);
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--primary-light);
  }
  .section h3 { font-size: 1.05rem; color: #1e293b; margin: 20px 0 12px; }

  /* QR-БЛОК */
  .qr-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .qr-box {
    background: #fff;
    border: 3px solid var(--primary);
    border-radius: 20px;
    padding: 16px;
    width: 260px;
    height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .qr-box img { width: 100%; height: 100%; }
  .qr-caption { text-align: center; color: var(--gray); font-size: 0.9rem; }

  .url-box {
    background: var(--primary-light);
    padding: 14px 18px;
    border-radius: 12px;
    font-family: monospace;
    font-size: 0.9rem;
    color: var(--primary);
    word-break: break-all;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    width: 100%;
    max-width: 600px;
    flex-wrap: wrap;
  }
  .copy-btn {
    background: var(--primary);
    color: #fff;
    border: none;
    padding: 8px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.85rem;
    font-family: inherit;
    white-space: nowrap;
  }
  .copy-btn:hover { background: #1557b0; }

  /* ИНСТРУКЦИЯ */
  .steps { list-style: none; counter-reset: step; }
  .steps li {
    counter-increment: step;
    padding: 16px 0 16px 56px;
    position: relative;
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
  }
  .steps li:last-child { border-bottom: none; }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 14px;
    width: 36px;
    height: 36px;
    background: var(--primary);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
  }
  .steps li b { color: var(--primary); }

  /* ТАБЛИЦЫ */
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin: 12px 0;
  }
  th, td { padding: 12px; text-align: left; border-bottom: 1px solid var(--border); }
  th { background: var(--primary-light); color: var(--primary); font-weight: 700; font-size: 0.85rem; }
  tr:hover { background: var(--light); }
  .ok { color: var(--success); font-weight: 700; }
  .no { color: var(--danger); font-weight: 700; }

  /* КНОПКИ */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 28px;
    font-size: 1rem;
    font-weight: 700;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
    text-decoration: none;
  }
  .btn-primary { background: var(--primary); color: #fff; box-shadow: 0 4px 12px rgba(30,111,217,0.3); }
  .btn-primary:hover { background: #1557b0; transform: translateY(-2px); }

  /* ИНФО-БЛОКИ */
  .info-block {
    background: var(--primary-light);
    border-left: 4px solid var(--primary);
    padding: 16px 20px;
    border-radius: 12px;
    margin: 16px 0;
    font-size: 0.95rem;
  }
  .info-block.warning { background: #fef3c7; border-left-color: var(--accent); }
  .info-block b { display: block; margin-bottom: 6px; }

  /* БАННЕР ПЕЧАТИ */
  .print-banner {
    background: linear-gradient(135deg, #ffb400, #f59e0b);
    color: #fff;
    border-radius: 16px;
    padding: 24px 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    box-shadow: var(--shadow);
    margin-bottom: 20px;
  }
  .print-banner h3 { font-size: 1.15rem; margin-bottom: 4px; }
  .print-banner p { font-size: 0.9rem; opacity: 0.95; }
  .print-banner .btn {
    background: #fff;
    color: #d97706;
    font-size: 1rem;
    padding: 16px 32px;
  }
  .print-banner .btn:hover { background: #fef3c7; transform: translateY(-2px); }

  /* БЛОК КЕЙСА */
  .case-block {
    margin-top: 20px;
    padding: 20px;
    background: #f0f9ff;
    border-radius: 14px;
    border: 2px solid var(--primary);
  }
  .case-block h3 {
    margin-bottom: 12px;
    color: var(--primary);
    font-size: 1.05rem;
  }
  .case-block p {
    font-size: 0.9rem;
    color: var(--gray);
    margin-bottom: 14px;
  }

  /* АДАПТИВ */
  @media print {
    body { background: #fff; }
    .section { box-shadow: none; border: 1px solid var(--border); page-break-inside: avoid; }
    .qr-section, .copy-btn, .print-banner { display: none; }
  }

  @media (max-width: 700px) {
    .header h1 { font-size: 1.3rem; }
    .section { padding: 20px; }
    .qr-box { width: 220px; height: 220px; }
    .print-banner { flex-direction: column; text-align: center; }
  }
</style>
</head>
